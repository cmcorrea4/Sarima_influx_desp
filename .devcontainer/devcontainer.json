{
  "name": "SARIMA + InfluxDB + FastAPI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "openBrowser"
    }
  },
  "secrets": {
    "INFLUX_URL":    { "description": "URL de InfluxDB, p.ej. https://us-east-1-1.aws.cloud2.influxdata.com" },
    "INFLUX_TOKEN":  { "description": "Token de lectura de InfluxDB" },
    "INFLUX_ORG":    { "description": "Organización de InfluxDB" },
    "INFLUX_BUCKET": { "description": "Bucket con los datos" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "humao.rest-client"
      ]
    }
  }
}
